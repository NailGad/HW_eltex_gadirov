# Определение компилятора
CC = gcc
# Определение архиватора для создания статических библиотек
AR = ar cr
# Флаги компиляции:
CFLAGS = -Wall -Wextra -std=c99
# Имя исполняемого файла (программы)
TARGET = calcul
# Имя статической библиотеки
LIBRARY = libcalc.a
# Список исходных файлов для библиотеки
SRCS = add.c div.c sub.c mul.c
# Преобразование списка .c файлов в .o файлы
OBJS = $(SRCS:.c=.o)

# Цель по умолчанию, выполняется при запуске make без аргументов
all: $(TARGET)

# Правило для создания исполняемого файла:
# calcul зависит от main.o и библиотеки libcalc.a
$(TARGET): main.o $(LIBRARY)
	$(CC) $(CFLAGS) -o $@ main.o -L. -lcalc

# Правило для создания статической библиотеки:
# libcalc.a зависит от всех объектных файлов (add.o, div.o и т.д.)
$(LIBRARY): $(OBJS)
	$(AR) $@ $(OBJS)

# Любой .o файл зависит от соответствующего .c файла
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# Зависит от TARGET, поэтому сначала соберет программу при необходимости
run: $(TARGET)
	# Запуск исполняемого файла
	./$(TARGET)


clean:
# Удаление всех объектных файлов, библиотеки и исполняемого файла
	rm -f *.o $(LIBRARY) $(TARGET)